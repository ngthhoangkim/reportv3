    "ChunkHours": 6,
    "MaxCandidatesPerChunk": 200,
    "DelayBetweenChunksMs": 1000,
    "ScanToDelayMinutes": 0,
    "Sources": [ "cdha" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
