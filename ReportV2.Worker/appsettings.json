{
  "ConnectionStrings": {
    "HisDb": ""
  },
  "Aspose": {
    "LicensePath": ""
  },
  "ReportV2": {
    "TemplatesPath": "Templates",
    "OutputPath": "output",
    "TempPath": "tmp",
    "StatePath": "data/state",
    "LogsPath": "logs",
    "SourceImageDir": "",
    "FallbackImageDir": "",
