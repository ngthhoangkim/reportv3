{
  "ConnectionStrings": {
    "HisDb": ""
  },
  "ReportV2": {
    "TemplatesPath": "Templates",
    "OutputPath": "output",
    "TempPath": "tmp",
    "StatePath": "data/state",
    "MaxHisConcurrency": 1,
    "MaxRenderConcurrency": 2
  },
  "Backfill": {
    "ChunkDays": 1,
    "MaxCandidatesPerChunk": 50,
