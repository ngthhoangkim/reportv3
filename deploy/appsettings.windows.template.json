{
  "ConnectionStrings": {
    "HisDb": "Server=YOUR_HIS_SQL_SERVER;Database=YOUR_HIS_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "Aspose": {
    "LicensePath": "C:\\ReportV2\\Aspose.Wordsfor.NET.lic"
  },
  "ReportV2": {
    "TemplatesPath": "C:\\ReportV2\\Templates",
    "OutputPath": "D:\\ReportV2\\output",
    "TempPath": "D:\\ReportV2\\tmp",
    "StatePath": "C:\\ReportV2\\data\\state",
    "LogsPath": "C:\\ReportV2\\logs",
    "SourceImageDir": "\\\\YOUR_IMAGE_SERVER\\YOUR_IMAGE_SHARE",
    "FallbackImageDir": "\\\\YOUR_IMAGE_SERVER\\YOUR_FALLBACK_SHARE",
    "LocalImageDir": "C:\\ReportV2\\Documents",
    "PrescriptionTemplateFront": "C:\\ReportV2\\Templates\\ToaThuocV2\\TT_MAT_1.docx",
    "PrescriptionTemplateBack": "C:\\ReportV2\\Templates\\ToaThuocV2\\TT_MAT_2.docx",
    "PrescriptionOutputPath": "D:\\ReportV2\\output\\prescriptions",
    "TempRetentionHours": 24,
    "LogRetentionDays": 30,
    "MaxLogsMegabytes": 512,
    "StateTempRetentionHours": 24,
    "MaxHisConcurrency": 1,
    "MaxRenderConcurrency": 2
  },
  "Upload": {
    "BaseUrl": "http://YOUR_UPLOAD_SERVICE_HOST:PORT",
    "Prefix": "khambenh/",
    "PrescriptionPrefix": "khambenh/toathuoc/",
    "CleanupAfterUpload": true
  },
  "Backfill": {
    "ChunkDays": 1,
    "MaxCandidatesPerChunk": 50,
    "DelayBetweenChunksMs": 2000,
    "Sources": [ "cdha", "prescription" ]
  },
  "SyncNew": {
    "LookbackHours": 48,
    "ChunkHours": 6,
    "MaxCandidatesPerChunk": 200,
    "DelayBetweenChunksMs": 1000,
    "ScanToDelayMinutes": 0,
    "Sources": [ "cdha", "prescription" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
